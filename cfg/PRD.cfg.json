{
  "timezone": "Europe/London",
  "timezone_hour_offset": 1,
  "chrome": {
    "browser": "/app/.apt/usr/bin/google-chrome",
    "driver": "/app/.chromedriver/bin/chromedriver",
    "sleep": 10,
    "reload_frequency": 100,
    "page_poll_sleep": 0.5,
    "max_query_attempts": 8
  },
  "cache_file": "cache.json",
  "runtime_args": {
    "wait_time": 60,
    "email": true,
    "message_box": false,
    "text_message": false
  },
  "midnight_boost": {
    "enabled": true,
    "hour": 0,
    "minutes": 25,
    "wait_time": 15
  },
  "polling": {
    "randomize": true,
    "jitter_ratio": 0.25,
    "seed": null
  },
  "diagnostics": {
    "enabled": true,
    "dir": "diagnostics"
  },
  "window": 9,
  "prune_cache_frequency": 15,
  "slot_notification_cool_down": 12,
  "schedule": {
